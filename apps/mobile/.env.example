# ─── @nhac/mobile environment ───
# Expo exposes vars prefixed with EXPO_PUBLIC_ to the client bundle.
# NEVER put secrets here — anything shipped to the device is public.

# Base URL of the Nhạc API. Use your machine's LAN IP (not localhost) when
# testing on a physical device, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase (anon/public key only — safe for clients, protected by RLS)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
