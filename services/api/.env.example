# ─── @nhac/api environment ───
# Copy to services/api/.env (or run from the repo root .env). See root .env.example for the full catalog.

NODE_ENV=development
LOG_LEVEL=debug
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Supabase (server uses the service-role key — keep secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=nhac-media
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=

# Fingerprinting
FINGERPRINT_PROVIDER=audd
AUDD_API_TOKEN=
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACOUSTID_API_KEY=

# ffmpeg (blank = use system PATH)
FFMPEG_PATH=
