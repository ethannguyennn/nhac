{
  "name": "nhac",
  "version": "0.1.0",
  "private": true,
  "description": "Nhạc — turn scattered concert footage into a replayable greatest-hits experience.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "shared:build": "npm run build --workspace @nhac/shared",
    "api:dev": "npm run dev --workspace @nhac/api",
    "web:dev": "npm run dev --workspace @nhac/web",
    "mobile:start": "npm run start --workspace @nhac/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
