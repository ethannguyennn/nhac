# ─────────────────────────────────────────────────────────────
# Nhạc — root environment template
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Each workspace also has its own `.env.example` (api / web / mobile).
# This root file documents the full set of secrets used across the repo.
# ─────────────────────────────────────────────────────────────

# ---- Supabase (metadata DB + auth) ----
# Project settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses RLS. NEVER expose to client apps.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Object storage (video files) — Cloudflare R2 (S3-compatible) ----
# R2 dashboard → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=nhac-media
# S3 endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Optional public/CDN base URL for served media (R2 custom domain)
R2_PUBLIC_BASE_URL=https://media.example.com

# ---- Song fingerprinting provider ----
# One of: audd | acrcloud | acoustid  (see docs/DECISIONS.md — verify pricing before committing)
FINGERPRINT_PROVIDER=audd

# AudD (https://audd.io) — simple REST, has a free trial tier
AUDD_API_TOKEN=your-audd-token

# ACRCloud (https://acrcloud.com) — alternative
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# AcoustID (https://acoustid.org) — free, open, MusicBrainz-backed (needs Chromaprint/fpcalc)
ACOUSTID_API_KEY=

# ---- API server ----
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated allowed origins for CORS
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Local path to ffmpeg binary (leave blank to use system PATH)
FFMPEG_PATH=

# ---- App environment ----
NODE_ENV=development
LOG_LEVEL=debug
