# ─────────────────────────────────────────────────────────────
# Nhạc — environment template. Copy to `.env` and adjust.
# The local MVP runs with ZERO changes (SQLite + local storage + mock
# fingerprinting). Fill in the cloud/provider sections only when you opt in.
# ─────────────────────────────────────────────────────────────

# ---- App ----
NHAC_ENV=development
NHAC_LOG_LEVEL=INFO
NHAC_SECRET_KEY=dev-insecure-change-me

# ---- Database ----
# Default: local SQLite file under ./var. Swap for Postgres later, e.g.
# NHAC_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/nhac
NHAC_DATABASE_URL=sqlite:///./var/nhac.sqlite3

# ---- Storage backend ----  local | s3
NHAC_STORAGE_BACKEND=local
NHAC_LOCAL_STORAGE_DIR=./var/media
# Public base path clients use to fetch media (local dev serves via the app).
NHAC_MEDIA_BASE_URL=/media

# ---- S3 / Cloudflare R2 (only when NHAC_STORAGE_BACKEND=s3) ----
NHAC_S3_BUCKET=nhac-media
NHAC_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
NHAC_S3_ACCESS_KEY_ID=
NHAC_S3_SECRET_ACCESS_KEY=
NHAC_S3_REGION=auto
NHAC_S3_PUBLIC_BASE_URL=

# ---- Fingerprinting ----  mock | audd | acoustid
# `mock` works fully offline (deterministic demo matches). Switch to a real
# provider once you have a key (see docs/DECISIONS.md).
NHAC_FINGERPRINT_PROVIDER=mock
NHAC_AUDD_API_TOKEN=
NHAC_ACOUSTID_API_KEY=

# ---- Media processing ----
# Blank = use `ffmpeg`/`ffprobe` from PATH.
NHAC_FFMPEG_PATH=
NHAC_FFPROBE_PATH=

# ---- Auth (MVP) ----
# The local MVP runs single-user with this seeded default account. Real
# multi-user auth is a post-MVP decision (see docs/NOTES.md).
NHAC_DEFAULT_USER_EMAIL=you@example.com
